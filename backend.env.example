# Database — PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/nexhire

# JWT Security
SECRET_KEY=your_super_secret_jwt_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Firebase (For Social Logins)
FIREBASE_KEY_PATH="firebase_key.json"
FIREBASE_WEB_API_KEY="your_firebase_web_api_key"

# Groq AI — primary AI provider (fastest inference, free tier)
GROQ_API_KEY=your_groq_api_key

# OpenRouter — fallback AI provider
OPENROUTER_API_KEY=your_openrouter_api_key

# GitHub OAuth — optional
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Cloudinary — cloud file/resume storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ElevenLabs — AI voice for video interviews
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# OpenAI — Whisper (speech-to-text fallback)
OPENAI_API_KEY=your_openai_api_key

# Frontend URL
FRONTEND_URL=http://localhost:5173

# App Configuration
APP_NAME=NexHire
APP_VERSION=1.0.0
DEBUG=True
